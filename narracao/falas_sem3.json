[{"id": "ep30_01", "ini": 24.43, "dur": 0.8, "texto": "Um!"}, {"id": "ep30_02", "ini": 26.02, "dur": 0.9, "texto": "Dois!"}, {"id": "ep30_03", "ini": 27.7, "dur": 0.8, "texto": "Tr\u00eas!"}, {"id": "ep30_04", "ini": 29.29, "dur": 1.0, "texto": "Quatro!"}, {"id": "ep30_05", "ini": 31.08, "dur": 1.1, "texto": "Cinco!"}, {"id": "ep30_06", "ini": 38.67, "dur": 1.6, "texto": "Seis!"}, {"id": "ep30_07", "ini": 41.1, "dur": 1.1, "texto": "Sete!"}, {"id": "ep30_08", "ini": 43.0, "dur": 1.0, "texto": "Oito!"}, {"id": "ep30_09", "ini": 44.76, "dur": 0.8, "texto": "Nove!"}, {"id": "ep30_10", "ini": 46.33, "dur": 0.8, "texto": "Dez!"}, {"id": "ep30_11", "ini": 91.46, "dur": 2.9, "texto": "Brincar junto \u00e9 mais gostoso."}, {"id": "ep30_12", "ini": 95.25, "dur": 0.9, "texto": "Vamos lembrar?"}, {"id": "ep30_13", "ini": 96.5, "dur": 3.9, "texto": "Um, dois, tr\u00eas, quatro, cinco."}, {"id": "ep30_14", "ini": 100.72, "dur": 4.0, "texto": "Seis, sete, oito, nove, dez!"}, {"id": "ep31_01", "ini": 4.3, "dur": 3.2, "texto": "Era um vaga-lume brincando de esconder."}, {"id": "ep31_02", "ini": 21.3, "dur": 2.7, "texto": "Olha l\u00e1 no capim... e no galho!"}, {"id": "ep31_03", "ini": 24.32, "dur": 0.8, "texto": "Um!"}, {"id": "ep31_04", "ini": 25.9, "dur": 0.9, "texto": "Dois!"}, {"id": "ep31_05", "ini": 27.59, "dur": 0.8, "texto": "Tr\u00eas!"}, {"id": "ep31_06", "ini": 29.18, "dur": 1.0, "texto": "Quatro!"}, {"id": "ep31_07", "ini": 30.97, "dur": 1.1, "texto": "Cinco!"}, {"id": "ep31_08", "ini": 42.93, "dur": 2.8, "texto": "Seis luzinhas brilhando na Lagoa."}, {"id": "ep31_09", "ini": 81.97, "dur": 0.9, "texto": "Vamos lembrar?"}, {"id": "ep31_10", "ini": 83.21, "dur": 2.6, "texto": "Um, dois, tr\u00eas vaga-lumes."}, {"id": "ep31_11", "ini": 86.07, "dur": 3.1, "texto": "Quatro, cinco... boa noite!"}, {"id": "ep32_01", "ini": 28.55, "dur": 2.9, "texto": "O oval \u00e9 redondo e comprido."}, {"id": "ep32_02", "ini": 37.5, "dur": 2.2, "texto": "O ret\u00e2ngulo tem quatro lados."}, {"id": "ep32_03", "ini": 39.96, "dur": 0.8, "texto": "Um!"}, {"id": "ep32_04", "ini": 41.54, "dur": 0.9, "texto": "Dois!"}, {"id": "ep32_05", "ini": 43.22, "dur": 0.8, "texto": "Tr\u00eas!"}, {"id": "ep32_06", "ini": 44.82, "dur": 1.0, "texto": "Quatro!"}, {"id": "ep32_07", "ini": 46.61, "dur": 3.5, "texto": "Dois lados compridos e dois curtinhos."}, {"id": "ep32_08", "ini": 80.79, "dur": 0.9, "texto": "Vamos lembrar?"}, {"id": "ep32_09", "ini": 82.04, "dur": 2.2, "texto": "O oval, igual a um ovo."}, {"id": "ep32_10", "ini": 84.54, "dur": 2.5, "texto": "O ret\u00e2ngulo, igual a uma porta."}, {"id": "ep33_01", "ini": 7.79, "dur": 2.6, "texto": "A Lili cruzou os bra\u00e7os, chateada."}, {"id": "ep33_02", "ini": 27.01, "dur": 1.5, "texto": "Um..."}, {"id": "ep33_03", "ini": 29.56, "dur": 0.9, "texto": "Dois..."}, {"id": "ep33_04", "ini": 31.61, "dur": 1.5, "texto": "Tr\u00eas..."}, {"id": "ep33_05", "ini": 78.73, "dur": 3.2, "texto": "\u00c0s vezes a gente ganha, \u00e0s vezes perde."}, {"id": "ep33_06", "ini": 82.84, "dur": 0.9, "texto": "Vamos lembrar?"}, {"id": "ep33_07", "ini": 84.08, "dur": 2.7, "texto": "Ficou chateado? Respira devagar."}, {"id": "ep33_08", "ini": 87.04, "dur": 2.0, "texto": "E a brincadeira continua."}, {"id": "ep34_01", "ini": 23.47, "dur": 2.0, "texto": "Vermelha, igual \u00e0 ma\u00e7\u00e3!"}, {"id": "ep34_02", "ini": 31.69, "dur": 2.1, "texto": "Azul, igual ao c\u00e9u!"}, {"id": "ep34_03", "ini": 39.89, "dur": 1.8, "texto": "Amarela, igual ao sol!"}, {"id": "ep34_04", "ini": 63.0, "dur": 2.3, "texto": "Vamos contar as penas da Pipa?"}, {"id": "ep34_05", "ini": 65.63, "dur": 0.8, "texto": "Um!"}, {"id": "ep34_06", "ini": 67.21, "dur": 0.9, "texto": "Dois!"}, {"id": "ep34_07", "ini": 68.89, "dur": 0.8, "texto": "Tr\u00eas!"}, {"id": "ep34_08", "ini": 73.28, "dur": 0.9, "texto": "Vamos lembrar?"}, {"id": "ep34_09", "ini": 74.53, "dur": 2.0, "texto": "Vermelho, azul e amarelo."}, {"id": "ep34_10", "ini": 76.87, "dur": 2.8, "texto": "Tr\u00eas penas, tr\u00eas cores!"}, {"id": "ep35_01", "ini": 4.96, "dur": 2.7, "texto": "A Lagoa estava ficando quietinha."}, {"id": "ep35_02", "ini": 27.47, "dur": 2.7, "texto": "A folha \u00e9 o cobertor dela."}, {"id": "ep35_03", "ini": 44.9, "dur": 2.4, "texto": "L\u00e1 embaixo \u00e9 escurinho e calmo."}, {"id": "ep35_04", "ini": 75.45, "dur": 0.9, "texto": "Vamos lembrar?"}, {"id": "ep35_05", "ini": 76.7, "dur": 3.3, "texto": "Borboleta na folha. Pipa no ninho."}, {"id": "ep35_06", "ini": 80.33, "dur": 3.2, "texto": "Peixinho no fundo. Bento na toca."}, {"id": "ep36_01", "ini": 19.49, "dur": 2.4, "texto": "Aqui na grama, conta comigo!"}, {"id": "ep36_02", "ini": 22.18, "dur": 0.8, "texto": "Um!"}, {"id": "ep36_03", "ini": 23.76, "dur": 0.9, "texto": "Dois!"}, {"id": "ep36_04", "ini": 25.44, "dur": 0.8, "texto": "Tr\u00eas!"}, {"id": "ep36_05", "ini": 29.57, "dur": 2.2, "texto": "E atr\u00e1s da flor..."}, {"id": "ep36_06", "ini": 32.07, "dur": 0.8, "texto": "Um!"}, {"id": "ep36_07", "ini": 33.66, "dur": 0.9, "texto": "Dois!"}, {"id": "ep36_08", "ini": 43.72, "dur": 2.5, "texto": "Juntando tudo: cinco!"}, {"id": "ep36_09", "ini": 75.95, "dur": 0.9, "texto": "Vamos lembrar?"}, {"id": "ep36_10", "ini": 77.2, "dur": 2.9, "texto": "Tr\u00eas ovos aqui, dois ovos l\u00e1."}, {"id": "ep36_11", "ini": 80.43, "dur": 3.4, "texto": "Tr\u00eas mais dois \u00e9 igual a cinco!"}, {"id": "ep37_01", "ini": 5.05, "dur": 2.6, "texto": "Uma nuvem cobria o c\u00e9u da Lagoa."}, {"id": "ep37_02", "ini": 19.31, "dur": 2.2, "texto": "A nuvem foi embora... olha!"}, {"id": "ep37_03", "ini": 21.77, "dur": 0.8, "texto": "Um!"}, {"id": "ep37_04", "ini": 23.35, "dur": 0.9, "texto": "Dois!"}, {"id": "ep37_05", "ini": 25.04, "dur": 0.8, "texto": "Tr\u00eas!"}, {"id": "ep37_06", "ini": 26.63, "dur": 1.0, "texto": "Quatro!"}, {"id": "ep37_07", "ini": 28.42, "dur": 1.1, "texto": "Cinco!"}, {"id": "ep37_08", "ini": 30.32, "dur": 1.6, "texto": "Seis!"}, {"id": "ep37_09", "ini": 32.75, "dur": 1.2, "texto": "Sete!"}, {"id": "ep37_10", "ini": 72.22, "dur": 2.6, "texto": "O Bento fechou os olhos devagar."}, {"id": "ep37_11", "ini": 75.76, "dur": 0.9, "texto": "Vamos lembrar?"}, {"id": "ep37_12", "ini": 77.01, "dur": 3.3, "texto": "Um, dois, tr\u00eas, quatro."}, {"id": "ep37_13", "ini": 80.6, "dur": 3.8, "texto": "Cinco, seis, sete estrelas. Boa noite!"}, {"id": "ep38_01", "ini": 24.8, "dur": 2.9, "texto": "U de uva! U de urso!"}, {"id": "ep38_02", "ini": 31.82, "dur": 0.6, "texto": "A!"}, {"id": "ep38_03", "ini": 33.15, "dur": 0.8, "texto": "E!"}, {"id": "ep38_04", "ini": 34.65, "dur": 1.6, "texto": "I!"}, {"id": "ep38_05", "ini": 36.91, "dur": 0.7, "texto": "O!"}, {"id": "ep38_06", "ini": 38.32, "dur": 0.8, "texto": "U!"}, {"id": "ep38_07", "ini": 69.36, "dur": 0.9, "texto": "Vamos lembrar?"}, {"id": "ep38_08", "ini": 70.6, "dur": 2.7, "texto": "A, E, I, O, U."}, {"id": "ep38_09", "ini": 73.59, "dur": 2.1, "texto": "U, igual a um copinho!"}, {"id": "ep39_01", "ini": 6.77, "dur": 2.5, "texto": "Todo mundo queria procurar ao mesmo tempo!"}, {"id": "ep39_02", "ini": 24.44, "dur": 2.1, "texto": "Vamos contar as vezes?"}, {"id": "ep39_03", "ini": 26.82, "dur": 0.8, "texto": "Um!"}, {"id": "ep39_04", "ini": 28.4, "dur": 0.9, "texto": "Dois!"}, {"id": "ep39_05", "ini": 30.08, "dur": 0.8, "texto": "Tr\u00eas!"}, {"id": "ep39_06", "ini": 68.67, "dur": 0.9, "texto": "Vamos lembrar?"}, {"id": "ep39_07", "ini": 69.92, "dur": 2.3, "texto": "Primeiro, depois, por \u00faltimo."}, {"id": "ep39_08", "ini": 72.55, "dur": 2.4, "texto": "Cada um na sua vez."}, {"id": "ep40_01", "ini": 4.1, "dur": 2.2, "texto": "O Bento era grande demais!"}, {"id": "ep40_02", "ini": 17.71, "dur": 1.9, "texto": "A Pipa \u00e9 pequena."}, {"id": "ep40_03", "ini": 22.13, "dur": 1.3, "texto": "Pequeno!"}, {"id": "ep40_04", "ini": 24.35, "dur": 1.9, "texto": "O Bento \u00e9 grande."}, {"id": "ep40_05", "ini": 29.57, "dur": 1.3, "texto": "Grande!"}, {"id": "ep40_06", "ini": 64.31, "dur": 0.9, "texto": "Vamos lembrar?"}, {"id": "ep40_07", "ini": 65.55, "dur": 2.7, "texto": "Pipa pequena, atr\u00e1s da flor."}, {"id": "ep40_08", "ini": 68.58, "dur": 2.6, "texto": "Bento grande, atr\u00e1s da \u00e1rvore."}, {"id": "ep41_01", "ini": 5.3, "dur": 2.3, "texto": "Eram duas formas de boa noite."}, {"id": "ep41_02", "ini": 21.33, "dur": 2.4, "texto": "Uma estrela! Vamos contar as pontas?"}, {"id": "ep41_03", "ini": 24.0, "dur": 0.8, "texto": "Um!"}, {"id": "ep41_04", "ini": 25.58, "dur": 0.9, "texto": "Dois!"}, {"id": "ep41_05", "ini": 27.27, "dur": 0.8, "texto": "Tr\u00eas!"}, {"id": "ep41_06", "ini": 28.86, "dur": 1.0, "texto": "Quatro!"}, {"id": "ep41_07", "ini": 30.65, "dur": 1.1, "texto": "Cinco!"}, {"id": "ep41_08", "ini": 40.44, "dur": 2.9, "texto": "O cora\u00e7\u00e3o \u00e9 a forma do carinho."}, {"id": "ep41_09", "ini": 74.48, "dur": 0.9, "texto": "Vamos lembrar?"}, {"id": "ep41_10", "ini": 75.72, "dur": 2.4, "texto": "Estrela, com cinco pontas."}, {"id": "ep41_11", "ini": 78.41, "dur": 2.6, "texto": "Cora\u00e7\u00e3o, a forma do carinho."}, {"id": "ep42_01", "ini": 16.95, "dur": 2.5, "texto": "Antes eram cinco, conta comigo!"}, {"id": "ep42_02", "ini": 19.74, "dur": 0.8, "texto": "Um!"}, {"id": "ep42_03", "ini": 21.32, "dur": 0.9, "texto": "Dois!"}, {"id": "ep42_04", "ini": 23.0, "dur": 0.8, "texto": "Tr\u00eas!"}, {"id": "ep42_05", "ini": 24.6, "dur": 1.0, "texto": "Quatro!"}, {"id": "ep42_06", "ini": 26.38, "dur": 1.1, "texto": "Cinco!"}, {"id": "ep42_07", "ini": 32.25, "dur": 2.2, "texto": "Cinco... tira dois..."}, {"id": "ep42_08", "ini": 34.75, "dur": 1.4, "texto": "Sobram tr\u00eas!"}, {"id": "ep42_09", "ini": 76.05, "dur": 0.9, "texto": "Vamos lembrar?"}, {"id": "ep42_10", "ini": 77.3, "dur": 2.4, "texto": "Eram cinco, sumiram dois."}, {"id": "ep42_11", "ini": 80.02, "dur": 3.0, "texto": "Cinco menos dois \u00e9 igual a tr\u00eas."}, {"id": "ep43_01", "ini": 3.6, "dur": 2.2, "texto": "O paninho do Bento tinha sumido."}, {"id": "ep43_02", "ini": 21.94, "dur": 0.8, "texto": "Um!"}, {"id": "ep43_03", "ini": 23.52, "dur": 0.9, "texto": "Dois!"}, {"id": "ep43_04", "ini": 25.2, "dur": 0.8, "texto": "Tr\u00eas!"}, {"id": "ep43_05", "ini": 26.8, "dur": 1.0, "texto": "Quatro!"}, {"id": "ep43_06", "ini": 28.58, "dur": 1.1, "texto": "Cinco!"}, {"id": "ep43_07", "ini": 30.48, "dur": 1.6, "texto": "Seis!"}, {"id": "ep43_08", "ini": 32.91, "dur": 1.2, "texto": "Sete!"}, {"id": "ep43_09", "ini": 34.88, "dur": 1.0, "texto": "Oito!"}, {"id": "ep43_10", "ini": 36.66, "dur": 1.5, "texto": "Nove!"}, {"id": "ep43_11", "ini": 38.96, "dur": 0.8, "texto": "Dez!"}, {"id": "ep43_12", "ini": 50.73, "dur": 3.0, "texto": "O paninho estava escondidinho."}, {"id": "ep43_13", "ini": 87.8, "dur": 0.9, "texto": "Vamos lembrar?"}, {"id": "ep43_14", "ini": 89.05, "dur": 2.3, "texto": "Perdeu alguma coisa? Respira."}, {"id": "ep43_15", "ini": 91.63, "dur": 3.7, "texto": "Conta at\u00e9 dez e procura devagar."}]